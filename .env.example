# =============================================================================
# APPLICATION CONFIGURATION
# Every variable here maps 1-to-1 to a field in src/app/settings.py.
# settings.py provides the fallback default if any variable is missing here.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
PROJECT_NAME="IB Job Skill Mapping System"

# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=test-secret-key-for-testing
JWT_ALGORITHM=HS256
SECRET_KEY=test-secret-key-for-testing
ACCESS_TOKEN_EXPIRE_MINUTES=3000000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5433/ib_job_skill_mapping

# -----------------------------------------------------------------------------
# LLM Provider (groq | openai | google)
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.2

# OpenAI
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=google/embeddinggemma-300m
OPENAI_INPUT_RATE=0.003
OPENAI_OUTPUT_RATE=0.006

# Groq
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant
INPUT_COST_GROQ=0.07
OUTPUT_COST_GROQ=0.07

# Google
# GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
INPUT_COST_GOOGLE=0.03
OUTPUT_COST_GOOGLE=0.06

# -----------------------------------------------------------------------------
# Embedding Model
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_MODEL_NAME=google/embeddinggemma-300m
EMBEDDING_DEVICE=cpu
# GEMMA_MODEL_PATH=
# GOOGLE_SERVICE_ACCOUNT_FILE=
MCP_GDRIVE_SERVER_PATH=src/mcp_servers/gdrive/server.py
HF_TOKEN=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

# -----------------------------------------------------------------------------
# pgvector
# -----------------------------------------------------------------------------
PGVECTOR_DIMENSION=768

# -----------------------------------------------------------------------------
# RAG Retrieval Pool Sizes
# -----------------------------------------------------------------------------
RAG_SQL_LIMIT=50             # LIMIT on semantic (vector) SQL query
RAG_KEYWORD_FETCH_LIMIT=50   # LIMIT on BM25 keyword SQL query
RAG_FINAL_CANDIDATES=10       # candidates passed to scoring after RRF merge

# -----------------------------------------------------------------------------
# RAG Multi-Vector Composite Weights (must sum to 1.0)
# -----------------------------------------------------------------------------
RAG_WEIGHT_FULL_JD=0.25
RAG_WEIGHT_LEVEL=0.35
RAG_WEIGHT_SKILLS_MANDATORY=0.20
RAG_WEIGHT_SKILLS_PREFERRED=0.10
RAG_WEIGHT_CERT=0.10

# -----------------------------------------------------------------------------
# Hybrid Search Ratios
# -----------------------------------------------------------------------------
HYBRID_RATIO_BM25=0.7
HYBRID_RATIO_VECTOR=0.3

# -----------------------------------------------------------------------------
# RAG Feature Flags
# -----------------------------------------------------------------------------
RAG_USE_LEVEL_VECTOR=true     # use jd_level_vector vs resume_embedding for level similarity

# -----------------------------------------------------------------------------
# Thresholds
# -----------------------------------------------------------------------------
FIT_SCORE_THRESHOLD=0.1
RAG_SIMILARITY_THRESHOLD=0.0

# -----------------------------------------------------------------------------
# Role-Specific Scoring Weights
# -----------------------------------------------------------------------------

# SENIOR
WEIGHT_MANDATORY_SENIOR=0.50
WEIGHT_PREFERRED_SENIOR=0.20
WEIGHT_SEMANTIC_SENIOR=0.20
WEIGHT_CONTEXT_SENIOR=0.05

# MID
WEIGHT_MANDATORY_MID=0.40
WEIGHT_PREFERRED_MID=0.20
WEIGHT_SEMANTIC_MID=0.20
WEIGHT_CONTEXT_MID=0.15

# JUNIOR
WEIGHT_MANDATORY_JUNIOR=0.30
WEIGHT_PREFERRED_JUNIOR=0.30
WEIGHT_SEMANTIC_JUNIOR=0.20
WEIGHT_CONTEXT_JUNIOR=0.15

# -----------------------------------------------------------------------------
# Global Weights (fallback — used outside role-specific paths)
# -----------------------------------------------------------------------------
WEIGHT_MANDATORY_SKILLS=0.30
WEIGHT_PREFERRED_SKILLS=0.20
WEIGHT_SEMANTIC_FIT=0.25
WEIGHT_EXPERIENCE=0.10
WEIGHT_CERTIFICATION=0.10
WEIGHT_LOCATION=0.10
WEIGHT_WORK_MODE=0.10
WEIGHT_JD_TEXT=0.05

# -----------------------------------------------------------------------------
# Seniority Experience Thresholds (months)
# -----------------------------------------------------------------------------
SENIOR_EXP_THRESHOLD=96    # 8 years
JUNIOR_EXP_THRESHOLD=24    # 2 years

# -----------------------------------------------------------------------------
# Qualification Gate Thresholds
# -----------------------------------------------------------------------------
MIN_SKILL_WEIGHTED_SENIOR=0.20
MIN_SEMANTIC_SENIOR=0.30
FIT_THRESHOLD_SENIOR=0.75

MIN_SKILL_WEIGHTED_MID=0.08
MIN_SEMANTIC_MID=0.20
FIT_THRESHOLD_MID=0.70

MIN_SKILL_WEIGHTED_JUNIOR=0.15
MIN_SEMANTIC_JUNIOR=0.15
FIT_THRESHOLD_JUNIOR=0.60

# -----------------------------------------------------------------------------
# AI Confidence / Override
# -----------------------------------------------------------------------------
AI_BOOST_SENIOR=0.08
AI_BOOST_MID=0.05
AI_OVERRIDE_THRESHOLD_SENIOR=0.75
AI_CONFIDENCE_THRESHOLD_BOOST=0.70
CONTEXT_BOOST_CAP=0.08

# -----------------------------------------------------------------------------
# Skill Scoring Mode
# Set both to 0 for binary mode (presence only, rating + experience ignored).
# Default weighted mode: SKILL_RATING_WEIGHT=0.6, SKILL_EXP_WEIGHT=0.4
# -----------------------------------------------------------------------------
SKILL_RATING_WEIGHT=0
SKILL_EXP_WEIGHT=0
SKILL_EXP_MONTHS_CAP=48        # experience months at which norm_exp reaches 1.0
PROFILE_TEXT_MATCH_WEIGHT=0.6  # contribution for text-only (no skill ID) matches

# Blend weight for full_jd_similarity in semantic score
# s_score = jd_level_similarity * (1 - weight) + full_jd_similarity * weight
# SCORING_BLEND_FULL_JD_WEIGHT=0.30

# -----------------------------------------------------------------------------
# Skill Family Detection & Skill Groupings
# These are now stored in the skill_config DB table (migration 20260604_01).
# The values below are used ONLY as an emergency fallback when the DB is
# unreachable. Update the DB rows (config_type='family' / 'group') to change
# them at runtime without a redeploy.
# -----------------------------------------------------------------------------
FRONTEND_KEYWORDS=react,angular,vue,html,css,javascript,js,frontend,ui,ux
BACKEND_KEYWORDS=python,java,scala,sql,node,backend,api,spark,snowflake,kafka,ai,ml
BACKEND_AI_INDICATORS=backend,ai,ml,data,python,spark,sql,snowflake

SKILL_GROUP_PYTHON=python,django,flask,fastapi,pandas,numpy,scikit-learn,pytorch,tensorflow
SKILL_GROUP_JAVASCRIPT=javascript,js,typescript,ts,react,node,next.js,angular,vue,html,css
SKILL_GROUP_SQL=sql,postgresql,postgres,mysql,sql server,snowflake,oracle,db2
SKILL_GROUP_BIG_DATA=spark,pyspark,hadoop,kafka,databricks
SKILL_GROUP_AI_ML=machine learning,ai,ml,nlp,llm,genai,deep learning,computer vision
SKILL_GROUP_CLOUD=aws,azure,gcp,docker,kubernetes,terraform

# -----------------------------------------------------------------------------
# Penalties
# -----------------------------------------------------------------------------
SKILL_FAMILY_PENALTY=-0.10
MAX_LLM_EXPLANATIONS=2

# -----------------------------------------------------------------------------
# Retry
# -----------------------------------------------------------------------------
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0

# -----------------------------------------------------------------------------
# Availability
# -----------------------------------------------------------------------------
AVAILABILITY_THRESHOLD_PERCENTAGE=80.0  # candidate available if total allocation < this %

# -----------------------------------------------------------------------------
# RAG Experience Sanity Bound
# -----------------------------------------------------------------------------
EXP_MAX_PLAUSIBLE_MONTHS=600  # values beyond this treated as no constraint (50 years)

# -----------------------------------------------------------------------------
# LLM Rate-Limit Retry (separate from general infra retry)
# -----------------------------------------------------------------------------
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=2.0

# -----------------------------------------------------------------------------
# Observability (LangSmith)
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=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
LANGCHAIN_PROJECT=ib-job-skill-mapping-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


