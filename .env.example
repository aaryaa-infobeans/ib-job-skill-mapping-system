# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ib_job_skill_mapping

# Database (Ingestion Service)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ib_job_skill_mapping
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# OAuth Configuration (Ingestion Service)
OAUTH_TOKEN_URL=https://external-system.example.com/oauth/token
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here
OAUTH_SCOPE=read:team-data

# External API Configuration (Ingestion Service)
API_BASE_URL=https://external-system.example.com
EXTERNAL_API_ENDPOINT=/api/v1/team-members/skill-availability
API_TIMEOUT=30

# Batch Processing Configuration (Ingestion Service)
BATCH_SIZE=100
MAX_RETRIES=3
RETRY_BASE_DELAY=60

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME="IB Job Skill Mapping System"

# Security
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here

# AI
OPENAI_API_KEY=your-openai-api-key-here

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Runtime (Ingestion Service)
DRY_RUN=false
