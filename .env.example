# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ib_job_skill_mapping

# Database (Ingestion Service)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ib_job_skill_mapping
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# OAuth Configuration (Ingestion Service)
OAUTH_TOKEN_URL=https://external-system.example.com/oauth/token
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here
OAUTH_SCOPE=read:team-data

# External API Configuration (Ingestion Service)
API_BASE_URL=https://external-system.example.com
EXTERNAL_API_ENDPOINT=/api/v1/team-members/skill-availability
API_TIMEOUT=30

# Batch Processing Configuration (Ingestion Service)
BATCH_SIZE=100
MAX_RETRIES=3
RETRY_BASE_DELAY=60

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME="IB Job Skill Mapping System"

# Security
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here

# AI
LLM_PROVIDER=google  # Options: openai, google, groq
EMBEDDING_PROVIDER=google  # Options: openai, google
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-flash-latest
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
MAX_LLM_EXPLANATIONS=3
MAX_TOKENS=2000

# Cost Rates (USD per 1M tokens)
INPUT_COST_OPENAI=0.15
OUTPUT_COST_OPENAI=0.60
INPUT_COST_GOOGLE=0.03
OUTPUT_COST_GOOGLE=0.06
INPUT_COST_GROQ=0.07
OUTPUT_COST_GROQ=0.07

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Runtime (Ingestion Service)
DRY_RUN=false

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-api-key-here
LANGCHAIN_PROJECT=ib-job-skill-mapping-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
